<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.NeratPay" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/np_accent</item>
        <item name="colorPrimaryVariant">@color/np_accent_dark</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/np_accent</item>
        <item name="colorSecondaryVariant">@color/np_accent_dark</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@color/np_background</item>
        <item name="android:navigationBarColor">@color/np_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <!-- Splash Screen theme -->
    <style name="Theme.NeratPay.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/np_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo</item>
        <item name="postSplashScreenTheme">@style/Theme.NeratPay</item>
    </style>
</resources>
